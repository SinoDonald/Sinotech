<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>

    <!-- 關鍵設定 1：禁止 NuGet 將系統內建的 .NET 8 核心 DLL 複製到輸出目錄，防止版本衝突 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- 抑制舊套件相容性警告 -->
    <NoWarn>$(NoWarn);NU1701;NETSDK1138</NoWarn>
  </PropertyGroup>

  <!-- 關鍵設定 2：明確引用 .NET 8 原生 Desktop (WinForms/WPF) 框架 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <!-- ── 第三方工程套件 ── -->
    <PackageReference Include="EPPlus" Version="7.5.2" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />

    <!-- ── 系統套件：已內建於 .NET 8 runtime，強制 Exclude 避免將舊版 DLL 帶入輸出目錄 ── -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.DirectoryServices" Version="10.0.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.Management" Version="10.0.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="10.0.10">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ── Revit 2025 API 參考 ── -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- ── WinForms 設計工具表單編譯聲明 ── -->
  <ItemGroup>
    <Compile Update="CSDSEM\AutoNumberSettingForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="CSDSEM\ProfessionalCodeForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>